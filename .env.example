# ---------------------------------------------------------------------------
# Kairos Tester configuration. Copy to .env and fill in real values.
# NEVER commit .env. Real values are ignored by .gitignore.
# ---------------------------------------------------------------------------

# PostgreSQL connection (working database)
DATABASE_URL="postgresql://kairos:CHANGE_ME@localhost:5432/kairos_tester?schema=public"

# Separate, disposable database used ONLY by `npm run test:db`.
# The integration tests create and delete data here. Never point it at DATABASE_URL.
TEST_DATABASE_URL="postgresql://kairos:CHANGE_ME@localhost:5432/kairos_tester_test?schema=public"

# Password used by docker-compose.yml for the local PostgreSQL container.
POSTGRES_PASSWORD="CHANGE_ME"

# Local tester account. Generate the hash with:  npm run hash-password
# (there is no default account; the app refuses sign-in until both are set)
TESTER_USERNAME=""
TESTER_DISPLAY_NAME=""
TESTER_PASSWORD_HASH=""

# Optional: token for an AI agent (e.g. Claude driving Playwright) to record runs for review.
# Value is the SHA-256 hex of the token. The agent can create environments/cycles, record
# AI-driven runs and attach evidence to them; it can never complete an attempt. Leave blank to disable.
AGENT_TOKEN_HASH=""

# Session lifetime in hours
SESSION_TTL_HOURS="12"
# Set to "true" when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE="false"

# Evidence storage (kept outside public/). Relative paths resolve from the project folder.
EVIDENCE_DIR="./storage/evidence"
EVIDENCE_MAX_BYTES="10485760"

# Maximum size of an imported XLSX/CSV file
IMPORT_MAX_BYTES="10485760"

# Ollama Cloud (server-side only; the key is never sent to the browser or logged)
OLLAMA_API_KEY=""
OLLAMA_CHAT_URL="https://ollama.com/api/chat"
OLLAMA_MODEL="deepseek-v4-pro:cloud"
OLLAMA_TIMEOUT_MS="120000"

# AI runner (npm run runner)
# How long the AI waits for an answer before parking the case and moving on (ms).
# Answering later puts the case back in the queue; the AI revisits it.
RUNNER_ASK_WAIT_MS="15000"
# "true" opens a visible browser window as well as the live view on the run page.
RUNNER_HEADED="false"
# Abandon a case that makes no progress for this long (ms).
RUNNER_CASE_TIMEOUT_MS="720000"
